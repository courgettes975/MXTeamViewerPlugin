<Project Sdk="Microsoft.NET.Sdk">

  <!-- Out-of-process helper: UI Automation (WPF UIAutomationClient), Windows Core Audio (COM) and
       window capture (System.Drawing). Kept out of the Logi Plugin Service process on purpose:
       the service host only loads Microsoft.NETCore.App, and a hang/crash here never takes the
       plugin down (the plugin restarts the agent). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MXTeamViewer.Agent</RootNamespace>
    <AssemblyName>MXTeamViewerAgent</AssemblyName>
    <Version>1.0.0</Version>
    <RollForward>LatestMajor</RollForward>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
